/** * GLOBAL CONSTANTS 
 */
const SOURCE_SHEET = "WIP";
const LOG_SHEET = "Time log";
const SUMMARY_SHEET = "Daily Summary";
const PAYOUT_SHEET = "Weekly Payout"; 
const STATUS_COL = 9;         // Column I
const WORK_DURATION_COL = 13; // Column M (Durasi Pengerjaan) - From Tgl Acc
const BENGKEL_DURATION_COL = 14; // Column N (Durasi di Bengkel) - From Tgl Masuk
const DONE_COL = 15;          // Column O (Tgl Penyerahan)

// Centralized Workflow Order (Used for Sorting and Counter Direction)
const WORKFLOW_ORDER = ["BELUM SPK", "LAS", "DEMPUL", "EPOXY", "CAT", "POLES", "FINISHING", "SELESAI", "PENYERAHAN"];

/**
 * 1. REAL-TIME UPDATES (onEdit)
 */
function onEdit(e) {
  const ss = e.source;
  const sheet = ss.getActiveSheet();
  const range = e.range;

  if (sheet.getName() !== SOURCE_SHEET || range.getColumn() !== STATUS_COL) return;

  const row = range.getRow();
  if (row < 2) return;

  const newValue = String(e.value || "").trim().toUpperCase();
  const oldValue = String(e.oldValue || "").trim().toUpperCase();
  
  if (!e.value || newValue === oldValue) return;

  // --- WORKFLOW ENFORCEMENT ---
  const oldIdx = WORKFLOW_ORDER.indexOf(oldValue);
  const newIdx = WORKFLOW_ORDER.indexOf(newValue);

  if (oldIdx !== -1 && newIdx !== -1) {
    if (newIdx > oldIdx + 1) {
      const response = Browser.msgBox("Workflow Alert", "You are skipping a step. Are you sure you want to move from " + oldValue + " to " + newValue + "?", Browser.Buttons.YES_NO);
      if (response === "no") {
        range.setValue(e.oldValue); 
        return;
      }
    }
  }

  const now = new Date();
  const tz = ss.getSpreadsheetTimeZone();
  const dateStamp = Utilities.formatDate(now, tz, "yyyy-MM-dd");
  const timeStamp = Utilities.formatDate(now, tz, "HH:mm:ss");

  // Read up to column 15 (O)
  const rowValues = sheet.getRange(row, 1, 1, 15).getValues()[0];
  const tglMasuk = new Date(rowValues[0]); // Column A
  const tglAcc = new Date(rowValues[1]);   // Column B

  // --- CALCULATION: DURASI DI BENGKEL (Column N) ---
  let bengkelDurDisplay = "0 Hari";
  if (tglMasuk instanceof Date && !isNaN(tglMasuk)) {
    const diffTime = Math.abs(now - tglMasuk);
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    bengkelDurDisplay = diffDays + " Hari";
  }

  // --- CALCULATION: DURASI PENGERJAAN (Column M) ---
  let pengerjaanDurDisplay = "";
  if (tglAcc instanceof Date && !isNaN(tglAcc)) {
    const diffTime = Math.abs(now - tglAcc);
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    pengerjaanDurDisplay = diffDays + " Hari";
  }

  const fullRowRange = sheet.getRange(row, 1, 1, 15);

  if (newValue === "PENYERAHAN") {
    sheet.getRange(row, DONE_COL).setValue(dateStamp); 
    sheet.getRange(row, BENGKEL_DURATION_COL).setValue(bengkelDurDisplay);
    
    // Only update pengerjaan if it's currently empty
    if (!rowValues[WORK_DURATION_COL - 1]) {
       sheet.getRange(row, WORK_DURATION_COL).setValue(pengerjaanDurDisplay);
    }

    fullRowRange.setBackground("#eeeeee").setFontColor("#999999");

    const payoutSheet = ss.getSheetByName(PAYOUT_SHEET);
    if (payoutSheet) {
      payoutSheet.appendRow([dateStamp, rowValues[2], rowValues[3], rowValues[4], rowValues[5], rowValues[9]]);
      ss.toast("Data added to Weekly Payout", "Success ✅");
    }
  } else {
    // If Status is SELESAI, lock the Durasi Pengerjaan (Column M)
    if (newValue === "SELESAI" && !rowValues[WORK_DURATION_COL - 1]) {
       sheet.getRange(row, WORK_DURATION_COL).setValue(pengerjaanDurDisplay);
    }
    
    // Always update Durasi di Bengkel (Column N) until it hits Penyerahan
    sheet.getRange(row, BENGKEL_DURATION_COL).setValue(bengkelDurDisplay);
    
    fullRowRange.setBackground(null).setFontColor(null);
    sheet.getRange(row, DONE_COL).clearContent();
  }

  // --- B. LOGGING ---
  const logSheet = ss.getSheetByName(LOG_SHEET);
  if (logSheet) {
    logSheet.appendRow([
      rowValues[0], rowValues[1], rowValues[2], rowValues[3], 
      rowValues[4], rowValues[5], rowValues[6], rowValues[7], 
      e.value, rowValues[9], rowValues[10], rowValues[11], 
      dateStamp, timeStamp
    ]);
  }

  // --- C. UPDATE DAILY SUMMARY ---
  updateSummaryCounts(ss, oldValue, newValue);

  // --- D. CUSTOM SORT WIP ---
  SpreadsheetApp.flush(); 
  const lastRowWip = sheet.getLastRow();
  if (lastRowWip > 1) {
    const fullRange = sheet.getRange(2, 1, lastRowWip - 1, 15);
    const data = fullRange.getValues();
    const backgrounds = fullRange.getBackgrounds();
    const fontColors = fullRange.getFontColors();

    const combined = data.map((rowArr, i) => {
      return { data: rowArr, bg: backgrounds[i], fc: fontColors[i] };
    });

    combined.sort((a, b) => {
      const statusA = String(a.data[STATUS_COL - 1]).trim().toUpperCase();
      const statusB = String(b.data[STATUS_COL - 1]).trim().toUpperCase();
      const posA = WORKFLOW_ORDER.indexOf(statusA) === -1 ? 99 : WORKFLOW_ORDER.indexOf(statusA);
      const posB = WORKFLOW_ORDER.indexOf(statusB) === -1 ? 99 : WORKFLOW_ORDER.indexOf(statusB);
      if (posA !== posB) return posA - posB;
      return new Date(a.data[0]) - new Date(b.data[0]); 
    });

    fullRange.setValues(combined.map(item => item.data));
    fullRange.setBackgrounds(combined.map(item => item.bg));
    fullRange.setFontColors(combined.map(item => item.fc));
  }
}

/**
 * Helper: Updates Masuk/Keluar with Directional Logic
 */
function updateSummaryCounts(ss, oldStatus, newStatus) {
  const summarySheet = ss.getSheetByName(SUMMARY_SHEET);
  if (!summarySheet) return;

  const oldIdx = WORKFLOW_ORDER.indexOf(oldStatus);
  const newIdx = WORKFLOW_ORDER.indexOf(newStatus);

  const lastRow = summarySheet.getLastRow();
  if (lastRow < 2) return;
  const statusData = summarySheet.getRange(2, 1, lastRow - 1, 1).getValues();

  const isForward = (oldIdx === -1) || (newIdx > oldIdx);
  const adj = isForward ? 1 : -1;

  for (let i = 0; i < statusData.length; i++) {
    let statusName = String(statusData[i][0]).trim().toUpperCase();
    let rowIdx = i + 2;

    if (isForward) {
      if (oldStatus && statusName === oldStatus) {
        let cell = summarySheet.getRange(rowIdx, 4); 
        cell.setValue((Number(cell.getValue()) || 0) + adj);
      }
      if (newStatus && statusName === newStatus) {
        let col = (newStatus === "PENYERAHAN") ? 4 : 3; 
        let cell = summarySheet.getRange(rowIdx, col);
        cell.setValue((Number(cell.getValue()) || 0) + adj);
      }
    } else {
      if (oldStatus && statusName === oldStatus) {
        let col = (oldStatus === "PENYERAHAN") ? 4 : 3;
        let cell = summarySheet.getRange(rowIdx, col);
        cell.setValue((Number(cell.getValue()) || 0) + adj); 
      }
      if (newStatus && statusName === newStatus) {
        let cell = summarySheet.getRange(rowIdx, 4); 
        cell.setValue((Number(cell.getValue()) || 0) + adj); 
      }
    }
  }
  calculateClosing(summarySheet);
}

function calculateClosing(sheet) {
  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return;
  const range = sheet.getRange(2, 2, lastRow - 1, 3);
  const values = range.getValues();
  const results = values.map(row => [(Number(row[0]) || 0) + (Number(row[1]) || 0) - (Number(row[2]) || 0)]);
  sheet.getRange(2, 5, results.length, 1).setValues(results);
}

/**
 * Executes the daily rollover logic.
 * Added logic to skip execution if today is Sunday.
 */
function dailyRollover() {
  const now = new Date();
  
  // getDay() returns 0 for Sunday, 1 for Monday, etc.
  if (now.getDay() === 0) {
    console.log("Rollover skipped: Today is Sunday.");
    return; 
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const summarySheet = ss.getSheetByName(SUMMARY_SHEET);
  if (!summarySheet) return;
  
  const lastRow = summarySheet.getLastRow();
  if (lastRow < 2) return;

  // Perform a final snapshot before resetting columns
  calculateClosing(summarySheet);

  const currentClosing = summarySheet.getRange(2, 5, lastRow - 1, 1).getValues();
  
  // Map Closing to Opening (Col B), and reset Masuk, Keluar, and current Closing to 0
  const resetData = currentClosing.map(row => [Number(row[0]) || 0, 0, 0, 0]); 
  summarySheet.getRange(2, 2, resetData.length, 4).setValues(resetData);
  
  console.log("Daily rollover completed successfully.");
}

function syncWIPtoQC(e) {
  // 1. SILENT CHECK: Only run if the edit happened in the "WIP" sheet
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheet = ss.getActiveSheet();
  if (sheet.getName() !== "WIP") return;

  var row = e.range.getRow();
  if (row < 2) return; // Skip header

  // 2. DEBOUNCE / WAIT LOGIC (5 Minutes = 300,000 milliseconds)
  var waitTime = 5 * 60 * 1000; 
  var now = new Date().getTime();
  PropertiesService.getScriptProperties().setProperty('lastEdit_' + row, now);

  Utilities.sleep(waitTime);

  // Check if a newer edit has happened to the same row while we were sleeping
  var lastEdit = PropertiesService.getScriptProperties().getProperty('lastEdit_' + row);
  if (lastEdit != now) return; // Exit if user is still typing in this row

  try {
    var destinationFileId = "1S6k_nloOzdFvEupaUyENQYRp71rtx-fH6w-0jN6ZoCU"; 
    var wipSheet = sheet;
    
    var qcFile = SpreadsheetApp.openById(destinationFileId);
    var qcSheet = qcFile.getSheetByName("Quality Control");

    // Get specific row data
    var rowValues = wipSheet.getRange(row, 1, 1, 5).getValues()[0];
    var wo = rowValues[2] ? rowValues[2].toString().trim() : "";      // Column C
    var police = rowValues[3] ? rowValues[3].toString().trim() : "";  // Column D
    var type = rowValues[4] ? rowValues[4].toString().trim() : "";    // Column E

    // 3. REQUIREMENT CHECK: All 3 columns must be filled
    if (wo === "" || police === "" || type === "") return;

    // 4. DUPLICATE CHECK: Look at QC sheet to see if WO exists
    var qcData = qcSheet.getRange("A:A").getValues();
    var existingWO = qcData.map(function(r) { return r[0].toString().trim(); });

    if (existingWO.indexOf(wo) === -1) {
      // Find real last row in QC
      var lastRow = 1;
      for (var i = qcData.length - 1; i >= 0; i--) {
        if (qcData[i][0] !== "") {
          lastRow = i + 1;
          break;
        }
      }
      
      // 5. SILENT TRANSFER
      qcSheet.getRange(lastRow + 1, 1, 1, 9).setValues([[wo, police, type, false, false, false, false, false, false]]);
      
      // Cleanup the property memory
      PropertiesService.getScriptProperties().deleteProperty('lastEdit_' + row);
    }

  } catch (err) {
    console.log("Error: " + err.message);
  }
}
